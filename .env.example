# ============================================================
# ZS Music Maker — шаблон переменных окружения
# Скопируй в .env и заполни при необходимости.
# ВСЕ ключи опциональны — приложение работает локально без них.
# ============================================================

# --- Пути (переопределяют дефолтные) ---
# Каталог установки программы (для updater; по умолчанию %ProgramFiles%\ZS Music Maker на Win)
# ZSMM_PROGRAM_DIR=
# Каталог пользовательских данных (проекты, voice_vault, output; по умолчанию %LOCALAPPDATA%\ZS Music Maker)
# ZSMM_USER_DIR=

# --- Поведение пайплайна ---
# Отключить TTL-чекпоинты pipeline_core (1 = выкл; по умолчанию чекпоинты живут 24ч)
# ZSMM_NO_CHECKPOINTS=1

# --- Поведение генератора битов ---
# Переопределить каталог вывода битов (по умолчанию output/beats)
# ZSMM_BEAT_OUTPUT_DIR=

# --- Внешние сервисы (ОПЦИОНАЛЬНО, всё бесплатно) ---
# Freesound API key (бесплатная регистрация на freesound.org) — расширяет поиск CC0-сэмплов
# FREESOUND_API_KEY=
# Pixabay API key (бесплатный) — поиск royalty-free сэмплов/звуков
# PIXABAY_API_KEY=

# --- AI/пайплайн (читаются config/settings.py, ШАГ 007) ---
# ZSMM_VRAM_GB=12
# ZSMM_RAM_GB=32
# ZSMM_CPU_THREADS=40
# ZSMM_PREFER_GPU=1
# ZSMM_TIMEOUT_SEC=3600
# ZSMM_OUTPUT_DIR=
# ZSMM_MODELS_DIR=
# ZSMM_LOGS_DIR=
# ZSMM_VAULT_DIR=
# Шрифт для обложек (app/core/font_utils.py, ШАГ 002)
# ZSMM_FONT_PATH=
