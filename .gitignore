# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
# Кэши тестов и тулинга: ни один из них не нужен в репозитории и не должен
# попадать в source-ZIP для обновления.
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.benchmarks/
# Ресурсы сборки Electron (иконка) — это исходник, а не артефакт.
!desktop/build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---------------------------------------------------------------- Окружения
.env
.venv
/.venv-rvc/
venv/
ENV/

# ---------------------------------------------------------------- IDE
.vscode/
.idea/
.aider*
*.swp
.DS_Store

# ---------------------------------------------------------------- Артефакты рендера
output/
# Резервная копия, которую пайплайн делает сам перед прогоном (preflight_backup):
# это состояние данных на момент запуска, а не файл проекта.
data/backups/
# Бит, сохранённый из окна Electron (кнопка «Сохранить WAV»)
data/beats/
/release/
checkpoints/
logs/
*.zip

# ---------------------------------------------------------------- Аудио/медиа: только фикстуры тестов версионируются
*.wav
# Скриншоты окна — это документация (docs/screenshots/), а не артефакты.
!docs/screenshots/**
# Демо-превью HIT FACTORY: в git живёт только страница и обложки.
# WAV-демо — это 55 МБ артефактов рендера, которые ни один тест не использует;
# они генерируются командами с этой же страницы и остаются локально.
!demo_site/**
demo_site/*.wav
*.mp3
*.flac
*.m4a
*.pkl
!tests/fixtures/**
!data/samples/**

# ---------------------------------------------------------------- Модели (тяжёлые, тянутся на машине пользователя)
models/**
!models/.gitkeep
!models/README.md

# ---------------------------------------------------------------- Пользовательские данные (НЕ версионируются)
lyric_vault/**
!lyric_vault/.gitkeep
!lyric_vault/slang.txt
voice_vault/**
!voice_vault/.gitkeep
training_texts/**
!training_texts/.gitkeep
references/**
!references/.gitkeep
data/user_profile.json
data/history.json
data/templates/
data/kpi_history.jsonl
data/health.json
data/kpi_dashboard.json
data/hw_profile.json
data/tutorial_settings.json
data/freesound.key
data/secrets.enc
data/reference_cache/*
!data/reference_cache/.gitkeep
data/ai_models/

# ---------------------------------------------------------------- Electron-оболочка
desktop/node_modules/
desktop/dist/
desktop/out/
desktop/*.log
# Конфигурация сборки генерируется: блок подписи появляется только при секретах.
desktop/build-config.generated.json
# Снимок чисел (data/desktop/readiness.json, inventory.md) версионируется:
# именно его читает окно и именно по нему проверяется устаревание.

